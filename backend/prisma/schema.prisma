// PulsePoster database schema (v1)
//
// Data flows top to bottom:
//   Source (where it came from, licence)
//     -> Asset (one uploaded image or text)
//        -> Annotation (human gold labels, JSON validated by event.v1.schema.json)
//        -> ExtractionRun (one model run on one asset)
//           -> FieldPrediction (one predicted field + confidence)
//        -> EventMention (one event found in an asset)
//           -> CanonicalEvent (the real-world event, after deduplication)
//     Correction (a human fix to a prediction; becomes future training data)

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm]
}

// ---------- Enums ----------

enum SourceKind {
  SYNTHETIC // generated by our flyer/text generator
  SELF_DESIGNED // flyers we made by hand
  ORGANISER_PERMISSION
  CREATIVE_COMMONS
  OWN_PHOTO
  USER_UPLOAD
}

enum AssetType {
  FLYER_IMAGE
  FLYER_PHOTO
  SOCIAL_SCREENSHOT
  CHAT_SCREENSHOT
  TEXT_CAPTION
  TEXT_MESSAGE
}

enum Split {
  UNASSIGNED
  TRAIN
  ADAPT // small real set used to adapt synthetic-trained models
  DEV
  TEST // locked: never used for training or tuning
}

enum ModelKind {
  IMAGE_EXTRACTOR
  TEXT_EXTRACTOR
  BASELINE_OCR_REGEX
  BASELINE_OCR_BERT
  DEDUP_MATCHER
  RETRIEVER
  PLANNER
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum LinkSource {
  MODEL
  HUMAN
}

enum PairDecision {
  PENDING
  SAME
  DIFFERENT
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  POSTPONED
  SOLD_OUT
  RELOCATED
}

// ---------- Users ----------

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  assets      Asset[]
  annotations Annotation[]
  corrections Correction[]
}

// ---------- Provenance / licence ledger ----------

model Source {
  id              String     @id @default(cuid())
  kind            SourceKind
  description     String // e.g. "Fest committee X, Oct 2026 posters"
  licence         String // e.g. "CC-BY-4.0", "organiser-release-v1", "internal"
  trainingAllowed Boolean
  redistributable Boolean // may images be published in the benchmark?
  permissionRef   String? // link/path to the signed release
  createdAt       DateTime   @default(now())
  assets          Asset[]
}

// ---------- Inputs ----------

model Asset {
  id           String    @id @default(cuid())
  sourceId     String
  source       Source    @relation(fields: [sourceId], references: [id])
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id])
  type         AssetType

  // image inputs
  storageKey     String? // object-storage path; images are not stored in Postgres
  width          Int?
  height         Int?
  sha256         String? @unique // exact-duplicate detection
  perceptualHash String? // near-duplicate detection (resized/recompressed copies)

  // text inputs
  text String?

  // context for resolving "tomorrow", missing years, timezones
  referenceDatetime DateTime? @db.Timestamptz
  referenceTimezone String?

  // leakage control
  split             Split   @default(UNASSIGNED)
  templateFamilyId  String? // synthetic template or organiser campaign
  canonicalEventKey String? // generator's event id; keeps all renders of one event in one split
  isSynthetic       Boolean @default(false)

  createdAt DateTime @default(now())

  annotations Annotation[]
  runs        ExtractionRun[]
  mentions    EventMention[]
  corrections Correction[]

  @@index([split])
  @@index([templateFamilyId])
  @@index([perceptualHash])
}

// ---------- Gold labels ----------

model Annotation {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  annotatorId   String
  annotator     User     @relation(fields: [annotatorId], references: [id])
  schemaVersion String // "1.0"
  data          Json // full record, validated against event.v1.schema.json
  isGold        Boolean  @default(false) // the adjudicated final label
  createdAt     DateTime @default(now())

  @@index([assetId])
}

// ---------- Models and runs ----------

model ModelVersion {
  id          String          @id @default(cuid())
  kind        ModelKind
  name        String // e.g. "donut-base-lora"
  version     String // e.g. "2026-11-03-a"
  artifactUri String // where the weights live
  config      Json? // hyperparameters, training data version
  metrics     Json? // headline eval numbers for this checkpoint
  createdAt   DateTime        @default(now())
  runs        ExtractionRun[]
  pairs       DuplicatePair[]

  @@unique([name, version])
}

model ExtractionRun {
  id             String       @id @default(cuid())
  assetId        String
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  modelVersionId String
  modelVersion   ModelVersion @relation(fields: [modelVersionId], references: [id])
  jobId          String? // BullMQ job id
  status         RunStatus    @default(QUEUED)
  rawOutput      String? // exactly what the model generated
  output         Json? // parsed result (null if parsing failed)
  isValid        Boolean? // did output pass the JSON schema?
  error          String?
  latencyMs      Int?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())

  fields   FieldPrediction[]
  mentions EventMention[]

  @@index([assetId])
  @@index([status])
}

model FieldPrediction {
  id          String        @id @default(cuid())
  runId       String
  run         ExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  eventIndex  Int // which event in the asset (0, 1, ...)
  field       String // "title", "start", "price", ...
  value       Json?
  confidence  Float? // 0-1, calibrated
  abstained   Boolean       @default(false) // model chose to ask the user
  corrections Correction[]

  @@unique([runId, eventIndex, field])
  @@index([confidence])
}

// ---------- Corrections (human-in-the-loop) ----------

model Correction {
  id                String           @id @default(cuid())
  assetId           String
  asset             Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fieldPredictionId String?
  fieldPrediction   FieldPrediction? @relation(fields: [fieldPredictionId], references: [id])
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  eventIndex        Int
  field             String
  oldValue          Json?
  newValue          Json?
  usedInDataset     String? // dataset version this fix was trained on, if any
  createdAt         DateTime         @default(now())

  @@index([assetId])
}

// ---------- Real-world events and deduplication ----------

model CanonicalEvent {
  id         String                      @id @default(cuid())
  title      String
  startAt    DateTime?                   @db.Timestamptz // filled only when year + timezone are known
  endAt      DateTime?                   @db.Timestamptz
  venueName  String?
  address    String?
  organiser  String?
  priceMin   Decimal?                    @db.Decimal(10, 2)
  priceMax   Decimal?                    @db.Decimal(10, 2)
  currency   String?                     @db.Char(3)
  ticketUrl  String?
  categories String[]
  status     EventStatus                 @default(SCHEDULED)
  details    Json // full merged record in schema format (raw text, tiers, evidence)
  embedding  Unsupported("vector(384)")? // for natural-language search
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  mentions   EventMention[]

  @@index([startAt])
}

model EventMention {
  id               String          @id @default(cuid())
  assetId          String
  asset            Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  runId            String?
  run              ExtractionRun?  @relation(fields: [runId], references: [id])
  eventIndex       Int
  canonicalEventId String?
  canonicalEvent   CanonicalEvent? @relation(fields: [canonicalEventId], references: [id])
  linkedBy         LinkSource?
  createdAt        DateTime        @default(now())

  pairsAsA DuplicatePair[] @relation("PairA")
  pairsAsB DuplicatePair[] @relation("PairB")

  @@unique([assetId, eventIndex, runId])
  @@index([canonicalEventId])
}

model DuplicatePair {
  id             String        @id @default(cuid())
  mentionAId     String
  mentionA       EventMention  @relation("PairA", fields: [mentionAId], references: [id], onDelete: Cascade)
  mentionBId     String
  mentionB       EventMention  @relation("PairB", fields: [mentionBId], references: [id], onDelete: Cascade)
  modelVersionId String?
  modelVersion   ModelVersion? @relation(fields: [modelVersionId], references: [id])
  score          Float? // matcher's "same event" probability
  decision       PairDecision  @default(PENDING)
  decidedBy      LinkSource?
  createdAt      DateTime      @default(now())

  @@unique([mentionAId, mentionBId]) // store each pair once, with A.id < B.id
  @@index([decision])
}